{
  "name": "zeroruntime-component-book-storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook catalog for zeroruntime-component-book — every component and state, shareable via Vercel.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "deploy": "npx vercel build --prod && npx vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zeroruntime-component-book": "github:zujonow/zeroruntime-component-book#v0.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/nextjs": "^10.4.4",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.6",
    "storybook": "^10.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
